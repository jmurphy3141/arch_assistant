      "notes": "compartment_id must be the tenancy OCID",
      "common_mistakes": [
        "Using 'rule' instead of 'matching_rule'",
        "Using 'match_rule' instead of 'matching_rule'",
        "Using 'filter' instead of 'matching_rule'",
        "Omitting 'description'"
      ]
    },
    "user": {
      "resource_type": "oci_identity_user",
      "required": ["compartment_id", "description", "name"],
      "commonly_used_optional": ["email"],
      "notes": "compartment_id must be the tenancy OCID",
      "common_mistakes": [
        "Omitting 'description'",
        "Using non-tenancy compartment_id"
      ]
    },
    "user_group_membership": {
      "resource_type": "oci_identity_user_group_membership",
      "required": ["group_id", "user_id"],
      "common_mistakes": [
        "Using 'oci_identity_group_membership' — does not exist"
      ]
    }
  },

  "security": {
    "vault": {
      "resource_type": "oci_kms_vault",
      "required": ["compartment_id", "display_name", "vault_type"],
      "vault_type_values": ["DEFAULT", "VIRTUAL_PRIVATE", "EXTERNAL"],
      "common_mistakes": [
        "Using 'oci_vault_vault' — does not exist, correct is oci_kms_vault",
        "Using 'type' instead of 'vault_type'",
        "Using 'name' instead of 'display_name'"
      ]
    },
    "kms_key": {
      "resource_type": "oci_kms_key",
      "required": ["compartment_id", "display_name", "key_shape", "management_endpoint"],
      "key_shape_block": {
        "required": ["algorithm", "length"],
        "algorithm_values": ["AES", "RSA", "ECDSA"],
        "common_lengths": {"AES": [16, 24, 32], "RSA": [256, 384, 512]},
        "optional": ["curve_id"]
      },
      "protection_mode_values": ["HSM", "SOFTWARE", "EXTERNAL"],
      "common_mistakes": [
        "Using 'oci_vault_key' — does not exist, correct is oci_kms_key",
        "Omitting 'management_endpoint' (obtain from oci_kms_vault.management_endpoint)",
        "Using 'key_type' instead of 'key_shape.algorithm'",
        "Using 'key_length' instead of 'key_shape.length'",
        "Using 'name' instead of 'display_name'"
      ]
    },
    "bastion": {
      "resource_type": "oci_bastion_bastion",
      "required": ["bastion_type", "compartment_id", "target_subnet_id"],
      "bastion_type_values": ["STANDARD"],
      "commonly_used_optional": ["name", "client_cidr_block_allow_list", "max_session_ttl_in_seconds", "dns_proxy_status"],
      "common_mistakes": [
        "Using 'subnet_id' instead of 'target_subnet_id'",
        "Using 'type' instead of 'bastion_type'",
        "Using 'oci_core_bastion' — does not exist, correct is oci_bastion_bastion"
      ]
    },
    "bastion_session": {
      "resource_type": "oci_bastion_session",
      "required": ["bastion_id", "key_details", "target_resource_details"],
      "common_mistakes": [
        "Using 'oci_bastion_bastion_session' — does not exist"
      ]
    }
  },

  "waf": {
    "web_app_firewall_policy": {
      "resource_type": "oci_waf_web_app_firewall_policy",
      "required": ["compartment_id"],
      "commonly_used_optional": ["display_name", "actions", "request_access_control", "request_protection", "request_rate_limiting", "response_access_control", "response_protection"],
      "common_mistakes": [
        "Using 'oci_waas_policy' — that is the legacy WAAS service, not WAF",
        "Using 'oci_waf_policy' — does not exist, correct is oci_waf_web_app_firewall_policy"
      ]
    },
    "web_app_firewall": {
      "resource_type": "oci_waf_web_app_firewall",
      "required": ["backend_type", "compartment_id", "load_balancer_id", "web_app_firewall_policy_id"],
      "backend_type_values": ["LOAD_BALANCER"],
      "common_mistakes": [
        "Using 'oci_waf_firewall' — does not exist",
        "Using 'policy_id' instead of 'web_app_firewall_policy_id'",
        "Using 'lb_id' instead of 'load_balancer_id'",
        "Omitting 'backend_type'"
      ]
    }
  },

  "monitoring_logging": {
    "alarm": {
      "resource_type": "oci_monitoring_alarm",
      "required": ["compartment_id", "destinations", "display_name", "is_enabled", "metric_compartment_id", "namespace", "query", "severity"],
      "severity_values": ["CRITICAL", "ERROR", "WARNING", "INFO"],
      "commonly_used_optional": ["body", "message_format", "pending_duration", "repeat_notification_duration", "resolution"],
      "message_format_values": ["RAW", "PRETTY_JSON", "ONS_OPTIMIZED"],
      "common_mistakes": [
        "Using 'oci_monitoring_rule' — does not exist",
        "Omitting 'severity'",
        "Omitting 'is_enabled'",
        "Using 'topic_id' directly instead of 'destinations' list (destinations takes ONS topic OCIDs)",
        "Using 'mql_query' instead of 'query'",
        "Omitting 'metric_compartment_id'"
      ]
    },
    "log_group": {
      "resource_type": "oci_logging_log_group",
      "required": ["compartment_id", "display_name"],
      "commonly_used_optional": ["description"],
      "common_mistakes": [
        "Using 'oci_log_group' — does not exist",
        "Using 'name' instead of 'display_name'"
      ]
    },
    "log": {
      "resource_type": "oci_logging_log",
      "required": ["display_name", "log_group_id", "log_type"],
      "log_type_values": ["CUSTOM", "SERVICE"],
      "commonly_used_optional": ["configuration", "is_enabled", "retention_duration"],
      "configuration_block": {
        "required": ["source"],
        "source_block_required": ["category", "resource", "service", "source_type"],
        "source_type_values": ["OCISERVICE"]
      },
      "common_mistakes": [
        "Using 'name' instead of 'display_name'",
        "Using 'log_group' instead of 'log_group_id'",
        "Omitting the configuration.source block for SERVICE logs",
        "Using 'type' instead of 'log_type'"
      ]
    }
  },

  "notifications": {
    "notification_topic": {
      "resource_type": "oci_ons_notification_topic",
      "required": ["compartment_id", "name"],
      "commonly_used_optional": ["description"],
      "common_mistakes": [
        "Using 'oci_ons_topic' — does not exist",
        "Using 'display_name' instead of 'name'",
        "Using 'topic_name' instead of 'name'"
      ]
    },
    "subscription": {
      "resource_type": "oci_ons_subscription",
      "required": ["compartment_id", "endpoint", "protocol", "topic_id"],
      "protocol_values": ["EMAIL", "SMS", "HTTPS", "SLACK", "PAGERDUTY", "ORACLE_FUNCTIONS", "CUSTOM_HTTPS"],
      "common_mistakes": [
        "Using 'oci_ons_topic_subscription' — does not exist",
        "Using 'url' instead of 'endpoint'",
        "Using 'email' instead of 'endpoint'",
        "Omitting 'protocol'"
      ]
    }
  },

  "events": {
    "events_rule": {
      "resource_type": "oci_events_rule",
      "required": ["actions", "compartment_id", "condition", "display_name", "is_enabled"],
      "actions_block": {
        "required": ["actions"],
        "actions_inner_required": ["action_type", "is_enabled"],
        "action_type_values": ["ONS", "OSS", "FAAS"],
        "conditional": {
          "function_id": "Required when action_type=FAAS",
          "stream_id": "Required when action_type=OSS",
          "topic_id": "Applicable when action_type=ONS"
        }
      },
      "common_mistakes": [
        "Using 'oci_cloud_events_rule' — does not exist",
        "Omitting 'is_enabled'",
        "Using 'filter' instead of 'condition'",
        "Forgetting the outer 'actions' block wrapper around the inner action list"
      ]
    }
  },

  "dns": {
    "dns_zone": {
      "resource_type": "oci_dns_zone",
      "required": ["compartment_id", "name", "zone_type"],
      "zone_type_values": ["PRIMARY", "SECONDARY"],
      "commonly_used_optional": ["scope", "view_id", "external_masters"],
      "scope_values": ["GLOBAL", "PRIVATE"],
      "common_mistakes": [
        "Using 'oci_core_dns_zone' — does not exist",
        "Omitting 'zone_type'",
        "Using 'dns_zone_type' instead of 'zone_type'",
        "Forgetting to set scope='PRIVATE' and view_id for private DNS zones"
      ]
    },
    "dns_record": {
      "resource_type": "oci_dns_rrset",
      "required": ["domain", "rtype", "zone_name_or_id"],
      "commonly_used_optional": ["items", "scope", "view_id"],
      "items_block": {
        "required": ["domain", "rdata", "rtype", "ttl"]
      },
      "common_mistakes": [
        "Using 'oci_dns_record' — does not exist, correct is oci_dns_rrset",
        "Using 'zone_id' instead of 'zone_name_or_id'",
        "Using 'record_type' instead of 'rtype'",
        "Using 'value' instead of 'rdata'"
      ]
    }
  },

  "api_gateway": {
    "gateway": {
      "resource_type": "oci_apigateway_gateway",
      "required": ["compartment_id", "endpoint_type", "subnet_id"],
      "endpoint_type_values": ["PUBLIC", "PRIVATE"],
      "commonly_used_optional": ["display_name", "certificate_id", "response_cache_details", "network_security_group_ids"],
      "common_mistakes": [
        "Using 'oci_api_gateway' — does not exist",
        "Using 'type' instead of 'endpoint_type'"
      ]
    },
    "deployment": {
      "resource_type": "oci_apigateway_deployment",
      "required": ["compartment_id", "gateway_id", "path_prefix", "specification"],
      "common_mistakes": [
        "Using 'oci_apigateway_api_deployment' — does not exist",
        "Using 'path' instead of 'path_prefix'"
      ]
    }
  },

  "functions": {
    "application": {
      "resource_type": "oci_functions_application",
      "required": ["compartment_id", "display_name", "subnet_ids"],
      "commonly_used_optional": ["config", "defined_tags", "freeform_tags", "image_policy_config", "network_security_group_ids", "shape"],
      "common_mistakes": [
        "Using 'oci_function_application' — does not exist",
        "Using 'subnet_id' (singular) instead of 'subnet_ids' (list)"
      ]
    },
    "function": {
      "resource_type": "oci_functions_function",
      "required": ["application_id", "display_name", "image", "memory_in_mbs"],
      "commonly_used_optional": ["config", "timeout_in_seconds", "provisioned_concurrency_config", "trace_config"],
      "common_mistakes": [
        "Using 'oci_function_function' — does not exist",
        "Using 'memory' instead of 'memory_in_mbs'",
        "Using 'docker_image' instead of 'image'"
      ]
    }
  },

  "streaming": {
    "stream": {
      "resource_type": "oci_streaming_stream",
      "required": ["compartment_id", "name", "partitions"],
      "commonly_used_optional": ["retention_in_hours", "stream_pool_id"],
      "common_mistakes": [
        "Using 'oci_stream' — does not exist",
        "Using 'partition_count' instead of 'partitions'"
      ]
    }
  },

  "data_sources_frequently_needed": {
    "availability_domains": {
      "data_type": "oci_identity_availability_domains",
      "required": ["compartment_id"],
      "usage": "data.oci_identity_availability_domains.ads.availability_domains[0].name"
    },
    "object_storage_namespace": {
      "data_type": "oci_objectstorage_namespace",
      "required": [],
      "usage": "data.oci_objectstorage_namespace.ns.namespace"
    },
    "oci_services": {
      "data_type": "oci_core_services",
      "required": [],
      "usage": "Used to look up service_id for oci_core_service_gateway. Filter by name containing 'All' for all services or 'Object Storage' for OSN."
    },
    "images": {
      "data_type": "oci_core_images",
      "required": ["compartment_id"],
      "commonly_used_filters": ["operating_system", "operating_system_version", "shape"],
      "usage": "data.oci_core_images.images.images[0].id"
    },
    "tenancy": {
      "data_type": "oci_identity_tenancy",
      "required": ["tenancy_id"],
      "usage": "data.oci_identity_tenancy.tenancy.id — use var.tenancy_ocid typically"
    }
  }
}
